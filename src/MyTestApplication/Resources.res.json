{
  "namespace": "MyApi.Resources",
  "class": "MyResources",
  "classAccessModifier": "Internal",
  "resources": [
    {
      "name": "Welcome",
      "default": "Welcome to my application, {name}",
      "translations": {
        "nb,nn": "Velkommen til min applikasjon, {name}",
        "sv": "Välkommen till min applikation"
      }
    },
    {
      "name": "Goodbye",
      "default": "Goodbye",
      "translations": {
        "nb": "Ha det bra",
        "nn": "Me pratast",
        "sv": "Hej då"
      }
    },
    {
      "name": "Notice",
      "type": "TextFile",
      "default": "Files/Notice.txt",
      "cacheTimeout": "00:00:30"
    },
    {
      "name": "Logo",
      "type": "Binary",
      "default": "Files/logo.png",
      "cacheTimeout": "infinite"
    }
  ]
}
